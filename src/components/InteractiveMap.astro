---
// Компонент интерактивной карты Leaflet для Legendarium
---

<div id="map-container" class="relative w-full h-[600px] rounded-xl overflow-hidden border border-amber-900/40 shadow-2xl bg-[#0d0f12]">
  <div id="map" class="w-full h-full"></div>
</div>

<!-- Загружаем стили Leaflet -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<script>
  import L from 'leaflet';

  // Инициализация карты
  document.addEventListener('DOMContentLoaded', () => {
    // Используем простой координатный сетку CRS.Simple для растровых фэнтези-карт
    const map = L.map('map', {
      crs: L.CRS.Simple,
      minZoom: -1,
      maxZoom: 2,
    });

    // Размеры вашей будущей карты в пикселях (пример)
    const bounds: L.LatLngBoundsExpression = [[0, 0], [1000, 1500]];
    
    // Временная заглушка сетки. Позже заменяется на твой файл изображения (карта фэнтези-мира)
    // L.imageOverlay('/images/world-map.png', bounds).addTo(map);

    map.fitBounds(bounds);

    // Пример добавления интерактивного пина (локации)
    const capitalMarker = L.marker([500, 750]).addTo(map);
    capitalMarker.bindPopup(`
      <div class="p-2 text-stone-900 font-serif">
        <h3 class="font-bold text-lg text-amber-900 border-b border-amber-800/30 pb-1 mb-1">Столица Империи</h3>
        <p class="text-xs text-stone-700 mb-2">Главный политический и культурный центр Серебряного Берега.</p>
        <a href="/wiki/capital" class="text-xs font-semibold text-amber-700 hover:text-amber-900 underline">Перейти к статье →</a>
      </div>
    `);
  });
</script>

<style is:global>
  /* Кастомная стилизация popup-окон Leaflet под свиток */
  .leaflet-popup-content-wrapper {
    background: #f4efe6 !important;
    border: 1px solid #78350f !important;
    border-radius: 8px !important;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5) !important;
  }
  .leaflet-popup-tip {
    background: #f4efe6 !important;
  }
</style>
