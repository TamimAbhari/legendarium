---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { shelves } from '../../data/library';

export async function getStaticPaths() {
  const books = await getCollection('library', (b) => import.meta.env.DEV || !b.data.draft);
  return books.map((book) => ({ params: { slug: book.id }, props: { book } }));
}

const { book } = Astro.props;
const { Content } = await render(book);
const shelf = shelves.find((s) => s.id === book.data.shelf);
---

<Base title={book.data.title} description={book.data.summary}>
  <article>
    <header class="article-head">
      <p class="category"><a href="/library/">Библиотека</a>{shelf && <> / {shelf.title}</>}</p>
      <h1 class="display page-title">{book.data.title}</h1>
      <p class="summary">{book.data.author}. {book.data.summary}</p>
    </header>
    <div class:list={['prose', { verse: book.data.shelf === 'poetry' }]}>
      <Content />
    </div>
  </article>
</Base>
