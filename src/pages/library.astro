---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { shelves } from '../data/library';

const books = (await getCollection('library', (b) => import.meta.env.DEV || !b.data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'ru'),
);

const heights = [15, 17, 14, 18, 16, 13, 17];
---

<Base title="Библиотека" description="Художественная проза, поэзия и рукописи жителей мира, расставленные по полкам.">
  <h1 class="display page-title">Библиотека</h1>
  <p class="lib-lead">
    Здесь тексты, а не справка: рассказы и стихи автора, хроники и записки жителей мира. Герои
    могут ошибаться и спорить друг с другом. Сухие факты о мире ищите в
    <a href="/world/">Энциклопедии</a>.
  </p>

  <div class="lib-filters" role="group" aria-label="Полки">
    <button type="button" class="chip" data-shelf="all" aria-pressed="true">Все полки</button>
    {shelves.map((s) => (
      <button type="button" class="chip" data-shelf={s.id} aria-pressed="false">{s.title}</button>
    ))}
  </div>

  <div class="lib-room">
    {shelves.map((shelf) => (
      <section class="shelf" data-shelf={shelf.id} aria-labelledby={`shelf-${shelf.id}`}>
        <h2 class="category-heading" id={`shelf-${shelf.id}`}>{shelf.title}</h2>
        <p class="shelf-desc">{shelf.description}</p>
        <ul class="spines">
          {books.filter((b) => b.data.shelf === shelf.id).map((book, i) => (
            <li style={`height:${heights[i % heights.length]}rem`}>
              <a class="spine" href={`/library/${book.id}/`} title={`${book.data.title}, ${book.data.author}`}>
                <span class="spine-title">{book.data.title}</span>
                <span class="spine-author">{book.data.author}</span>
              </a>
            </li>
          ))}
          {Array.from({ length: shelf.slots }).map((_, i) => (
            <li class="spine spine-empty" style={`height:${heights[(i + 2) % heights.length]}rem`} aria-hidden="true"></li>
          ))}
        </ul>
        <div class="shelf-board"></div>
        {!books.some((b) => b.data.shelf === shelf.id) && <p class="shelf-empty">Книги появятся здесь скоро.</p>}
      </section>
    ))}
  </div>

  <script>
    const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
    const shelves = document.querySelectorAll<HTMLElement>('.shelf');
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const id = chip.dataset.shelf;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        shelves.forEach((s) => (s.hidden = id !== 'all' && s.dataset.shelf !== id));
      }),
    );
  </script>
</Base>
