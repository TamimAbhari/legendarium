---
import Base from '../layouts/Base.astro';
import { getWorldEntries, groupByCategory } from '../lib/world';

const entries = await getWorldEntries();

// Статьи для знакомства с миром: порядок задаёт автор.
const startSlugs = ['continent', 'free-people', 'order', 'great-war'];
const start = startSlugs
  .map((slug) => entries.find((e) => e.id === slug))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));

const groups = groupByCategory(entries);
---

<Base>
  <section class="hero">
    <h1 class="display">Legendarium</h1>
    <p class="lead">
      Авторская энциклопедия вымышленного мира: земли, народы, ордена и магия. Здесь собрано то, что
      известно о нём наверняка.
    </p>
    <a class="button" href="/world/">Читать о мире</a>
  </section>

  {start.length > 0 && (
    <section class="section" aria-labelledby="start-title">
      <h2 class="section-title" id="start-title">С чего начать</h2>
      <ul class="entry-list">
        {start.map((entry) => (
          <li>
            <a href={`/world/${entry.id}/`}>
              <span class="entry-title">{entry.data.title}</span>
              <span class="entry-summary">{entry.data.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {groups.length > 0 && (
    <section class="section" aria-labelledby="index-title">
      <h2 class="section-title" id="index-title">Разделы энциклопедии</h2>
      <ul class="aside-list" style="columns: 14rem auto; column-gap: 2rem;">
        {groups.map((group) => (
          <li>
            <a href={`/world/#${group.category}`}>{group.category}</a>
            <span style="color: var(--muted);"> — {group.entries.length}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
