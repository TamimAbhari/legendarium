---
import Base from '../layouts/Base.astro';
import { getWorldEntries } from '../lib/world';

const entries = await getWorldEntries();
const factions = entries.filter((e) => e.data.faction).sort((a, b) => a.data.order - b.data.order);

const startSlugs = ['continent', 'free-people', 'great-war'];
const start = startSlugs
  .map((slug) => entries.find((e) => e.id === slug))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));
---

<Base>
  <section class="hero">
    <h1 class="display">Legendarium</h1>
    <p>
      Legendarium — оригинальный авторский мир, а этот сайт — его первоисточник: всё, что известно о
      мире, собрано и записано здесь. Я, Abhari Tamim, создатель этого мира и автор всех материалов.
      Цель проекта — создать и постоянно расширять большой, подробно проработанный мир со своей
      историей, культурой, языками и верованиями, а также писать по нему художественные
      произведения. На сайте две части: энциклопедия, где изложены факты о мире, и библиотека, где
      лежат рассказы, стихи и рукописи, написанные от лица жителей этого мира.
    </p>
  </section>

  <section class="section" aria-labelledby="factions-title">
    <h2 class="section-title" id="factions-title">Фракции</h2>
    <div class="faction-scroller" tabindex="0" role="region" aria-label="Фракции, прокручивается по горизонтали">
      {factions.map((f) => (
        <a class="faction-card" href={`/world/${f.id}/`}>
          <span class="fc-kind">{f.data.category}</span>
          <span class="fc-title display">{f.data.title}</span>
          <span class="fc-summary">{f.data.summary}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="ways-title">
    <h2 class="section-title" id="ways-title">Два способа читать</h2>
    <div class="two-ways">
      <a class="way" href="/world/">
        <span class="way-title display">Энциклопедия</span>
        <span>Справка о мире: земли, народы, организации, события и магия. Здесь только факты от автора.</span>
      </a>
      <a class="way" href="/library/">
        <span class="way-title display">Библиотека</span>
        <span>Тексты для чтения: рассказы, песни, хроники и записки жителей мира. Герои могут ошибаться.</span>
      </a>
    </div>
  </section>

  {start.length > 0 && (
    <section class="section" aria-labelledby="start-title">
      <h2 class="section-title" id="start-title">С чего начать</h2>
      <ul class="entry-list">
        {start.map((entry) => (
          <li>
            <a href={`/world/${entry.id}/`}>
              <span class="entry-title">{entry.data.title}</span>
              <span class="entry-summary">{entry.data.summary}</span>
            </a>
          </li>
        ))}
      </ul>
      <p style="margin-top: 1.25rem;"><a href="/world/">Все статьи энциклопедии</a></p>
    </section>
  )}

</Base>
