---
import Base from '../../layouts/Base.astro';
import { getWorldEntries, groupByCategory, getMissingArticles } from '../../lib/world';

const entries = await getWorldEntries();
const groups = groupByCategory(entries);

// Подсказка автору: на какие названия уже ссылаются, но статей нет. Только в dev.
const missing = import.meta.env.DEV ? getMissingArticles(entries) : [];
---

<Base
  title="Мир"
  description="Земли, народы, организации, события и магия вымышленного мира: все статьи энциклопедии."
>
  <h1 class="display page-title">Мир</h1>
  <p class="article-head summary" style="margin-top: 1rem; color: var(--muted);">
    Все статьи энциклопедии. Красным подчёркнуты названия, о которых пока нет статьи.
  </p>

  {groups.length === 0 && <p style="margin-top: 2rem;">Статей пока нет. Добавьте первую в <code>src/content/world/</code>.</p>}

  {groups.map((group) => (
    <section>
      <h2 class="category-heading" id={group.category}>{group.category}</h2>
      <ul class="entry-list">
        {group.entries.map((entry) => (
          <li>
            <a href={`/world/${entry.id}/`}>
              <span class="entry-title">
                {entry.data.title}
                {entry.data.draft && <span class="draft-badge">черновик</span>}
              </span>
              <span class="entry-summary">{entry.data.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  {missing.length > 0 && (
    <section class="section">
      <div class="dev-note">
        <h2>Ещё не написано (видно только в dev)</h2>
        <ul class="aside-list">
          {missing.map((item) => (
            <li>
              <strong>{item.name}</strong>
              <span style="color: var(--muted);">
                {' '}— упоминается в: {item.from.map((e) => e.data.title).join(', ')}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>
